# Template only — never put real credentials in this file.
# Copy to .env.local (gitignored) and fill that in instead.

# --- Database -------------------------------------------------------------
# Include the database name in the path, or Mongo defaults to "test".
# A replica set (Atlas, or a local rs) is needed for transactions.
MONGODB_URI="mongodb://127.0.0.1:27017/iev-tracker"

# --- Auth -----------------------------------------------------------------
# Minimum 32 characters. Signs sessions AND peppers OTP hashes, so use random
# bytes rather than a passphrase:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_MAX_AGE_SECONDS="43200"

# --- Email (OTP delivery) -------------------------------------------------
# console = log the OTP to the server console (development only; the env
#           schema refuses to boot with this in production)
# smtp    = deliver through an SMTP relay
# resend  = deliver through the Resend API
EMAIL_PROVIDER="console"

# SMTP relay. Required when EMAIL_PROVIDER=smtp.
# SMTP_PASSWORD is a credential: put the real value in .env.local only.
# ZeptoMail: host smtp.zeptomail.in, port 587, user emailapikey.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""


# The From address, shared by every provider.
EMAIL_FROM="IEV Tracker <noreply@xlri.ac.in>"

# --- Cloudinary (evidence storage) ----------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="iev-tracker/evidence"

# --- Seed -----------------------------------------------------------------
SEED_ADMIN_EMAIL="komalsinha@xlri.ac.in"
SEED_ADMIN_NAME="IEV Administrator"

# --- Misc -----------------------------------------------------------------
LOG_LEVEL="info"
