{
  "name": "iev-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed": "tsx --tsconfig tsconfig.scripts.json scripts/seed.ts",
    "seed:demo": "tsx --tsconfig tsconfig.scripts.json scripts/seed-demo.ts",
    "seed:cohort": "tsx --tsconfig tsconfig.scripts.json scripts/seed-cohort.ts",
    "migrate:attendance": "tsx --tsconfig tsconfig.scripts.json scripts/migrate-venture-attendance.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "check:smtp": "tsx --tsconfig tsconfig.scripts.json scripts/check-smtp.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.30.0",
    "mongoose": "^9.9.1",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
